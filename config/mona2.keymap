#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
/* DYA Studio から作成したマクロを呼び出す `&rmacro <slot>` を定義する。
   slot は 0 〜 CONFIG_ZMK_RUNTIME_MACRO_COUNT-1 (現状 0〜7)。
   どのマクロがどのスロットに入っているかは DYA Studio のマクロ一覧で確認する。
   キーへの割り当ては DYA Studio のキーマップエディタからも行える。 */
#include <behaviors/runtime_macro.dtsi>
/* デフォルトレイヤー変更 behavior `&df`。
   DYA Studio の「OSごとのデフォルトレイヤー」から設定できるほか、
   キーマップエディタで `&df DF_SEL <layer>` / `&df DF_INC` を
   任意のキーに割り当てられる。 */
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
/* nemu-link: radio 切替 behavior `&nl_mode` (0=BLE, 1=独自2.4GHz, 2=toggle)。
   初期キーマップに割り当てがなくても include は必須 */
#include <behaviors/nemu_link.dtsi>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100


/ {
    behaviors {
        mg_set_0: behavior_mg_set_0 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 0";
        };

        mg_set_1: behavior_mg_set_1 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 1";
        };

        mg_set_2: behavior_mg_set_2 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 2";
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    /* sekigon dynamic-combo slots。stock combo listener (keymap より先に
       実行される) 経由で評価されるため hold-tap 位置でも正しく発火する。
       設定 record は shared scope で ESB 経由 dongle と同期される。 */
    combo_slot0: combo_slot0 {
        compatible = "sekigon,dynamic-combo-slot";
        slot-index = <0>;
        target-role = "keyboard-right";
        default-key-positions = <38 39>;
        default-binding = <&lt 5 ESC>;
    };

    combo_slot1: combo_slot1 {
        compatible = "sekigon,dynamic-combo-slot";
        slot-index = <1>;
        target-role = "keyboard-right";
        default-key-positions = <11 12>;
        default-binding = <&kp TAB>;
    };

    combo_slot2: combo_slot2 {
        compatible = "sekigon,dynamic-combo-slot";
        slot-index = <2>;
        target-role = "keyboard-right";
        default-key-positions = <17 18>;
        default-binding = <&mkp MB3>;
    };

    combo_slot3: combo_slot3 {
        compatible = "sekigon,dynamic-combo-slot";
        slot-index = <3>;
        target-role = "keyboard-right";
        default-key-positions = <18 19>;
        default-binding = <&mkp MB2>;
    };

    combo_slot4: combo_slot4 {
        compatible = "sekigon,dynamic-combo-slot";
        slot-index = <4>;
        target-role = "keyboard-right";
        default-key-positions = <33 37>;
        default-binding = <&kp LC(SPACE)>;
    };

    /* 静的マクロ。キーマップ上で &BT0 / &screenshot などの名前で直接
       参照しているため、そのまま残している (DYA Studio 上では編集不可)。
       DYA Studio から編集したいマクロは Web UI で新規作成し、
       キーに `&rmacro <slot>` を割り当てて使う。 */
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        BT0: BT0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT0";
        };

        BT1: BT1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 1>;

            label = "BT1";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tp_repeat_mo1: tp_repeat_mo1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_REPEAT_MO1";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダ用 runtime-configurable sensor rotate
        // デフォルトはスクロール (cw=SCRL_DOWN, ccw=SCRL_UP)
        // DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
        // kp C_VOL_UP/DN や kp LEFT/RIGHT などへ動的変更可能

        /* sekigon dynamic-encoder adapter: dynamic_sensor_binding_lookup フックが
           Studio 保存済みレコードを解決する際に使用する (DT_INST(0) として必須)。 */
        runtime_encoder: runtime_encoder {
            compatible = "sekigon,dynamic-behavior-runtime-encoder";
            #binding-cells = <0>;
            #sensor-binding-cells = <0>;
        };

        /* 通常レイヤーの既定エンコーダ動作: 静的スクロール。
           dynamic-encoder で該当レイヤーに保存済みレコードがあればそちらが優先される。 */
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        zfold: zfold {
            compatible = "zmk,behavior-hold-tap";
            label = "ZFOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            hold-while-undecided;
        };

        zfoldZ: zfoldZ {
            compatible = "zmk,behavior-tap-dance";
            label = "ZFOLDZ";
            #binding-cells = <0>;
            bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_00_mac_layer {
            display-name = "MAC";
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &kp G    &kp LG(LEFT_BRACKET)    &kp H    &kp J    &kp K    &kp L    &lt 2 SEMICOLON
                &mt LEFT_SHIFT Z    &kp X    &kp C    &kp V    &kp B    &kp F13    &kp LG(RIGHT_BRACKET)    &kp N    &kp M    &kp COMMA    &kp PERIOD    &mt RIGHT_SHIFT SLASH
                &kp LEFT_CONTROL    &kp LEFT_ALT    &kp LEFT_GUI    &lt 1 LC(DELETE)    &lt 4 SPACE    &lt 3 LC(SPACE)    &kp BACKSPACE    &lt 3 RETURN    &lt 3 TAB
            >;
            sensor-bindings = <&scroll_encoder>; /* JSON: sensorIndex 0 */
        };

        layer_01_num_m_layer {
            display-name = "NUM_M";
            bindings = <
                &kp LS(N1)    &kp LS(N2)    &kp LS(N3)    &kp LS(N4)    &kp LS(N5)    &kp LS(N6)    &kp LS(N7)    &kp LS(N8)    &kp LS(N9)    &kp LS(N0)
                &kp GRAVE    &kp LS(N9)    &kp LS(N0)    &kp LEFT_BRACKET    &kp RIGHT_BRACKET    &trans    &mkp MB3    &mkp MB1    &mkp MB2    &kp EQUAL    &kp MINUS
                &trans    &kp LG(X)    &kp LS(LG(C))    &kp LG(V)    &kp LG(B)    &trans    &trans    &trans    &trans    &trans    &kp SQT    &kp NON_US_BACKSLASH
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&scroll_encoder>; /* JSON: sensorIndex 0 */
        };

        layer_02_mouse_m_layer {
            display-name = "MOUSE_M";
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &mkp MB1    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&scroll_encoder>; /* JSON: sensorIndex 0 */
        };

        layer_03_scrl_m_layer {
            display-name = "SCRL_M";
            bindings = <
                &trans    &kp LC(LS(TAB))    &kp LA(UP)    &kp LC(TAB)    &trans    &trans    &trans    &kp LS(LG(UP))    &trans    &trans
                &trans    &kp LA(LEFT)    &trans    &kp LA(RIGHT)    &trans    &trans    &trans    &kp LG(LEFT)    &kp LG(DOWN)    &kp LG(RIGHT)    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp LG(W)    &kp LS(LG(T))    &kp LC(LS(EQUAL))    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
            /* SCRL_M は音量固定 (param1=CW=Vol+, param2=CCW=Vol-)。
               dynamic-encoder レコードが有効化されると静的バインドより
               優先されるため、その場合は Studio 側の割当が使われる。 */
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>; /* JSON: sensorIndex 0 */
        };

        layer_04_fn_m_layer {
            display-name = "FN_M";
            bindings = <
                &trans    &kp LA(LEFT)    &kp UP    &kp LA(RIGHT)    &trans    &kp LS(N8)    &kp N7    &kp N8    &kp N9    &kp LS(EQUAL)
                &trans    &kp LEFT    &kp DOWN    &kp RIGHT    &trans    &trans    &kp SLASH    &kp N4    &kp N5    &kp N6    &kp MINUS
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp N0    &kp N1    &kp N2    &kp N3    &kp RETURN
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&scroll_encoder>; /* JSON: sensorIndex 0 */
        };

        layer_05_ble_m_layer {
            display-name = "BLE_M";
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4
                &kp F6    &kp F7    &kp F8    &kp F9    &trans    &nl_mode 0    &nl_mode 1    &trans    &trans    &trans    &trans
                &trans    &kp N1    &kp N2    &kp N3    &trans    &trans    &bootloader    &trans    &trans    &trans    &trans    &bt BT_CLR
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &bt BT_CLR_ALL
            >;
            sensor-bindings = <&scroll_encoder>; /* JSON: sensorIndex 0 */
        };







    };
};
